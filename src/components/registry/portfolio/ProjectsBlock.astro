---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import SmartImage from "@components/ui/atoms/SmartImage.astro";
import jsonData from "@data/sections/nova-projects.json";
import { ACTIVE_TEMPLATE } from "@config/template";

type MediaKind = "image" | "radar" | "solar";
type ProjectSummary = {
  paragraphs: string[];
  formulaLabel: string;
  formula: string;
  componentsLabel: string;
  components: string[];
  applicationsLabel: string;
  applications: string;
};
type ReportTable = { headers: string[]; rows: string[][] };
type ReportSection = {
  heading: string;
  paragraphs?: string[];
  list?: string[];
  ordered?: boolean;
  table?: ReportTable;
  note?: string;
  code?: string;
};
type Project = {
  category?: string;
  title: string;
  description?: string;
  image?: string;
  alt?: string;
  href?: string;
  linkLabel?: string;
  media?: MediaKind;
  fit?: "cover" | "contain";
  summary?: ProjectSummary;
  reportLabel?: string;
  report?: ReportSection[];
};
interface Props { title?: string; description?: string; linkLabel?: string; linkHref?: string; items?: Project[]; class?: string; }
const props = Astro.props as Props;
const fallback = ACTIVE_TEMPLATE === "nova" ? undefined : jsonData;
const title = props.title ?? fallback?.title;
const description = props.description ?? fallback?.description;
const linkLabel = props.linkLabel ?? fallback?.linkLabel;
const linkHref = props.linkHref ?? fallback?.linkHref;
const items = (props.items ?? fallback?.items ?? []) as Project[];

const radarTicks = Array.from({ length: 36 }, (_, index) => ({
  angle: index * 10,
  major: index % 3 === 0,
}));

// Why: expandable project reports (details/summary) reuse one label style so
// every report section heading looks the same without repeating class strings.
const reportHeadingClass =
  "!text-xs !font-extrabold uppercase tracking-[0.18em] text-brand-dark/70";
const reportTitleClass = "!text-base !font-extrabold text-brand-dark";
---

<Section id="projects" tone="page" class:list={["relative z-[1] -mt-4 rounded-t-[var(--rounded-lg)] pb-16", props.class]}>
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="projects-intro" data-motion-sequence="viewport">
      <div>
        <Heading tag="h2" variant="section-title">{title}</Heading>
      </div>
      <div>
        <Text variant="lead">{description}</Text>
        <a class="projects-link group" href={linkHref}>
          <Text tag="span" variant="body" class="transition-transform duration-300 ease-out group-hover:-translate-x-1 motion-reduce:transition-none">{linkLabel}</Text>
          <span class="inline-flex size-5 items-center justify-center leading-none transition-transform duration-300 ease-out group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {/* Why: the grid is an explicit viewport sequence so cards arrive one
        after another instead of the whole grid fading as a single block.
        The soft profile keeps the cascade quiet at four cards. */}
    <div class="projects-grid" data-motion-sequence="viewport" data-motion-profile="soft">
      {items.map((item) => (
        item.summary || item.report ? (
          <details class="project-card__link project-card__expandable group" name="project">
            <summary class="project-card__summary">
              <article class="project-card">
                <figure class:list={["project-card__figure", item.fit === "contain" && "project-card__figure--contain"]}>
                  {item.media === "radar" ? (
                    <div class="project-media project-media--radar" aria-hidden="true">
                      <div class="radar-scope">
                        <div class="radar-scope__screen">
                          <div class="radar-scope__rotor">
                            <span class="radar-scope__trail"></span>
                            <span class="radar-scope__beam"></span>
                          </div>
                          <svg class="radar-scope__grid" viewBox="0 0 320 320">
                            <g class="radar-rings">
                              <circle cx="160" cy="160" r="150" />
                              <circle cx="160" cy="160" r="112" />
                              <circle cx="160" cy="160" r="74" />
                              <circle cx="160" cy="160" r="36" />
                            </g>
                            <g class="radar-cross">
                              <line x1="10" y1="160" x2="310" y2="160" />
                              <line x1="160" y1="10" x2="160" y2="310" />
                              <line x1="54" y1="54" x2="266" y2="266" />
                              <line x1="266" y1="54" x2="54" y2="266" />
                            </g>
                            <g class="radar-ticks">
                              {radarTicks.map((tick) => (
                                <line
                                  x1="160"
                                  y1="6"
                                  x2="160"
                                  y2={tick.major ? 20 : 13}
                                  transform={`rotate(${tick.angle} 160 160)`}
                                />
                              ))}
                            </g>
                          </svg>
                          <span class="radar-scope__blip radar-scope__blip--1"></span>
                          <span class="radar-scope__blip radar-scope__blip--2"></span>
                          <span class="radar-scope__blip radar-scope__blip--3"></span>
                          <span class="radar-scope__glass"></span>
                        </div>
                      </div>
                    </div>
                  ) : item.media === "solar" ? (
                    <div class="project-media project-media--solar" aria-hidden="true">
                      <span class="solar-sky"></span>
                      <span class="solar-sun"></span>
                      <span class="solar-ground"></span>
                      <svg class="solar-scene" viewBox="0 0 320 240" preserveAspectRatio="xMidYMax meet">
                        <ellipse class="solar-shadow" cx="164" cy="212" rx="84" ry="11" />
                        <rect class="solar-pole" x="152" y="146" width="14" height="66" rx="5" />
                        <g class="solar-panel">
                          <polygon class="solar-panel__back" points="60,100 252,84 260,138 68,154" />
                          <polygon class="solar-panel__face" points="64,103 248,88 255,134 71,149" />
                          <g class="solar-panel__cells">
                            <line x1="108" y1="96" x2="116" y2="150" />
                            <line x1="156" y1="92" x2="164" y2="146" />
                            <line x1="204" y1="88" x2="212" y2="142" />
                            <line x1="63" y1="118" x2="255" y2="102" />
                            <line x1="66" y1="136" x2="258" y2="120" />
                          </g>
                          <polygon class="solar-panel__glare" points="64,103 132,97 96,149 71,149" />
                        </g>
                      </svg>
                    </div>
                  ) : (
                    <SmartImage src={item.image} alt={item.alt ?? ""} width={1280} height={800} loading="lazy" class="transition-transform duration-[1200ms] ease-out group-hover:scale-[1.02] motion-reduce:transition-none" />
                  )}
                  <figcaption class="project-card__overlay">
                    <div class="project-card__text">
                      {item.category && <span class="project-card__category">{item.category}</span>}
                      <Heading tag="h3" variant="feature-title" class="project-card__title">{item.title}</Heading>
                      {item.description && <p class="project-card__description">{item.description}</p>}
                    </div>
                    <span class="project-card__arrow overflow-hidden" aria-hidden="true">
                      <span class="relative flex size-5 items-center justify-center leading-none">
                        <span class="absolute inset-0 flex items-center justify-center leading-none transition-transform duration-300 ease-out group-hover:translate-x-[140%] group-hover:-translate-y-[140%] motion-reduce:transition-none">↗</span>
                        <span class="absolute inset-0 flex items-center justify-center leading-none -translate-x-[140%] translate-y-[140%] transition-transform duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0 motion-reduce:transition-none">↗</span>
                      </span>
                    </span>
                  </figcaption>
                </figure>
              </article>
            </summary>
            {(item.summary || (item.report && item.report.length > 0)) && (
              <div class="project-card__full">
                {item.summary && (
                  <div class="space-y-3">
                    {item.summary.paragraphs.map((paragraph) => (
                      <Text tag="p" variant="feature-body-sm" class="!leading-relaxed">{paragraph}</Text>
                    ))}
                    <Heading tag="h4" class={reportHeadingClass}>{item.summary.formulaLabel}</Heading>
                    <Text tag="p" variant="feature-body-sm" class="rounded-sm bg-brand-dark/5 px-4 py-3 font-mono">{item.summary.formula}</Text>
                    <Heading tag="h4" class={reportHeadingClass}>{item.summary.componentsLabel}</Heading>
                    <ul class="ml-5 list-disc space-y-1 marker:text-brand-accent">
                      {item.summary.components.map((component) => (
                        <li><Text tag="span" variant="feature-body-sm">{component}</Text></li>
                      ))}
                    </ul>
                    <Heading tag="h4" class={reportHeadingClass}>{item.summary.applicationsLabel}</Heading>
                    <Text tag="p" variant="feature-body-sm" class="!leading-relaxed">{item.summary.applications}</Text>
                  </div>
                )}
                {item.reportLabel && item.report && item.report.length > 0 && (
                  <div class="space-y-5 border-t border-brand-dark/10 pt-5">
                    <Heading tag="h3" class={reportTitleClass}>{item.reportLabel}</Heading>
                    {item.report.map((section) => (
                      <div class="space-y-2">
                        <Heading tag="h4" class={reportHeadingClass}>{section.heading}</Heading>
                        {section.paragraphs?.map((paragraph) => (
                          <Text tag="p" variant="feature-body-sm" class="!leading-relaxed">{paragraph}</Text>
                        ))}
                        {section.list && (
                          section.ordered ? (
                            <ol class="ml-5 list-decimal space-y-1 marker:text-brand-accent">
                              {section.list.map((entry) => (
                                <li><Text tag="span" variant="feature-body-sm">{entry}</Text></li>
                              ))}
                            </ol>
                          ) : (
                            <ul class="ml-5 list-disc space-y-1 marker:text-brand-accent">
                              {section.list.map((entry) => (
                                <li><Text tag="span" variant="feature-body-sm">{entry}</Text></li>
                              ))}
                            </ul>
                          )
                        )}
                        {section.table && (
                          <div class="overflow-x-auto rounded-sm border border-brand-dark/10">
                            <table class="w-full min-w-[28rem] border-collapse text-left">
                              <thead>
                                <tr class="bg-brand-dark/5">
                                  {section.table.headers.map((header) => (
                                    <th scope="col" class="border-b border-brand-dark/10 px-4 py-2 text-xs font-extrabold uppercase tracking-[0.14em]">{header}</th>
                                  ))}
                                </tr>
                              </thead>
                              <tbody>
                                {section.table.rows.map((row) => (
                                  <tr class="border-b border-brand-dark/10 last:border-0">
                                    {row.map((cell, cellIndex) => (
                                      cellIndex === 0 ? (
                                        <th scope="row" class="px-4 py-2 align-top text-sm font-bold">{cell}</th>
                                      ) : (
                                        <td class="px-4 py-2 align-top text-sm">{cell}</td>
                                      )
                                    ))}
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        )}
                        {section.note && (
                          <Text tag="p" variant="feature-body-sm" class="!text-brand-dark/70">{section.note}</Text>
                        )}
                        {section.code && (
                          <pre class="overflow-x-auto rounded-sm bg-brand-dark p-4 text-[0.8rem] leading-relaxed text-brand-light"><code>{section.code}</code></pre>
                        )}
                      </div>
                    ))}
                  </div>
                )}
                {item.href && (
                  <div class="flex flex-wrap items-center gap-3 border-t border-brand-dark/10 pt-5">
                    <a
                      href={item.href}
                      target={item.href.startsWith("http") ? "_blank" : undefined}
                      rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
                      class="ui-button ui-button-primary h-11 px-6 text-sm"
                      onclick="event.stopPropagation()"
                    >
                      <span>{item.linkLabel ?? "View live site"}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                )}
              </div>
            )}
          </details>
        ) : (
        <a class="project-card__link group" href={item.href ?? linkHref}>
          <article class="project-card">
          <figure class:list={["project-card__figure", item.fit === "contain" && "project-card__figure--contain"]}>
            {item.media === "radar" ? (
              <div class="project-media project-media--radar" aria-hidden="true">
                <div class="radar-scope">
                  <div class="radar-scope__screen">
                    <div class="radar-scope__rotor">
                      <span class="radar-scope__trail"></span>
                      <span class="radar-scope__beam"></span>
                    </div>
                    <svg class="radar-scope__grid" viewBox="0 0 320 320">
                      <g class="radar-rings">
                        <circle cx="160" cy="160" r="150" />
                        <circle cx="160" cy="160" r="112" />
                        <circle cx="160" cy="160" r="74" />
                        <circle cx="160" cy="160" r="36" />
                      </g>
                      <g class="radar-cross">
                        <line x1="10" y1="160" x2="310" y2="160" />
                        <line x1="160" y1="10" x2="160" y2="310" />
                        <line x1="54" y1="54" x2="266" y2="266" />
                        <line x1="266" y1="54" x2="54" y2="266" />
                      </g>
                      <g class="radar-ticks">
                        {radarTicks.map((tick) => (
                          <line
                            x1="160"
                            y1="6"
                            x2="160"
                            y2={tick.major ? 20 : 13}
                            transform={`rotate(${tick.angle} 160 160)`}
                          />
                        ))}
                      </g>
                    </svg>
                    <span class="radar-scope__blip radar-scope__blip--1"></span>
                    <span class="radar-scope__blip radar-scope__blip--2"></span>
                    <span class="radar-scope__blip radar-scope__blip--3"></span>
                    <span class="radar-scope__glass"></span>
                  </div>
                </div>
              </div>
            ) : item.media === "solar" ? (
              <div class="project-media project-media--solar" aria-hidden="true">
                <span class="solar-sky"></span>
                <span class="solar-sun"></span>
                <span class="solar-ground"></span>
                <svg class="solar-scene" viewBox="0 0 320 240" preserveAspectRatio="xMidYMax meet">
                  <ellipse class="solar-shadow" cx="164" cy="212" rx="84" ry="11" />
                  <rect class="solar-pole" x="152" y="146" width="14" height="66" rx="5" />
                  <g class="solar-panel">
                    <polygon class="solar-panel__back" points="60,100 252,84 260,138 68,154" />
                    <polygon class="solar-panel__face" points="64,103 248,88 255,134 71,149" />
                    <g class="solar-panel__cells">
                      <line x1="108" y1="96" x2="116" y2="150" />
                      <line x1="156" y1="92" x2="164" y2="146" />
                      <line x1="204" y1="88" x2="212" y2="142" />
                      <line x1="63" y1="118" x2="255" y2="102" />
                      <line x1="66" y1="136" x2="258" y2="120" />
                    </g>
                    <polygon class="solar-panel__glare" points="64,103 132,97 96,149 71,149" />
                  </g>
                </svg>
              </div>
            ) : (
              <SmartImage src={item.image} alt={item.alt ?? ""} width={1280} height={800} loading="lazy" class="transition-transform duration-[1200ms] ease-out group-hover:scale-[1.02] motion-reduce:transition-none" />
            )}
            <figcaption class="project-card__overlay">
              <div class="project-card__text">
                {item.category && <span class="project-card__category">{item.category}</span>}
                <Heading tag="h3" variant="feature-title" class="project-card__title">{item.title}</Heading>
                {item.description && <p class="project-card__description">{item.description}</p>}
              </div>
              <span class="project-card__arrow overflow-hidden" aria-hidden="true">
                <span class="relative flex size-5 items-center justify-center leading-none">
                  <span class="absolute inset-0 flex items-center justify-center leading-none transition-transform duration-300 ease-out group-hover:translate-x-[140%] group-hover:-translate-y-[140%] motion-reduce:transition-none">↗</span>
                  <span class="absolute inset-0 flex items-center justify-center leading-none -translate-x-[140%] translate-y-[140%] transition-transform duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0 motion-reduce:transition-none">↗</span>
                </span>
              </span>
            </figcaption>
          </figure>
          </article>
        </a>
        )
      ))}
    </div>
  </Container>
</Section>

<style>
  .projects-intro {
    display: grid;
    gap: 1.5rem;
  }

  .projects-intro > div:first-child {
    min-width: 0;
  }

  .projects-intro > div:last-child {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  .projects-intro :global(.ui-type-section-title) {
    max-width: 37rem;
  }

  .projects-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-brand-dark);
    text-decoration: none;
  }

  .projects-link:hover,
  .projects-link:focus-visible {
    color: var(--color-brand-accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  .project-card {
    min-width: 0;
  }

  .project-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 3px;
  }

  /* Why: cards with a report open inline via native details/summary (no JS,
     keyboard accessible). The whole card is the toggle; the report renders
     in a light panel below the figure. */
  details.project-card__link {
    display: block;
  }

  .project-card__summary {
    display: block;
    cursor: pointer;
    list-style: none;
    border-radius: var(--ui-radius-lg);
    /* transform, not translate: the reveal in motion.css animates translate,
       so a hover lift on the same property would fight it. */
    transition: transform 400ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  /* Pointer-only: a lift triggered by :hover on touch sticks after the tap,
     which reads as a stuck state rather than feedback. */
  @media (hover: hover) {
    .project-card__summary:hover {
      transform: translateY(-0.3rem);
    }
  }

  /* Press feedback for the tap that actually opens the report. */
  .project-card__summary:active {
    transform: translateY(-0.05rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__summary,
    .project-card__summary:hover,
    .project-card__summary:active {
      transform: none;
      transition: none;
    }
  }

  .project-card__summary::-webkit-details-marker {
    display: none;
  }

  .project-card__summary:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 3px;
  }

  /* The report panel is the card's payoff, so it arrives with a short rise
     rather than snapping open. Plain `animation` (no fill-mode) keeps the
     check:atomic transition contract intact and leaves the resting state
     untouched, so closing the details stays instant. */
  details.project-card__link[open] .project-card__full {
    animation: nova-report-in 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes nova-report-in {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .project-card__full {
    margin-top: 1.25rem;
    border-radius: var(--ui-radius-lg);
    background: var(--color-surface-container-low);
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--color-brand-dark);
  }

  .project-card__full > * + * {
    margin-top: 1.25rem;
  }

  .project-card figure {
    position: relative;
    display: grid;
    aspect-ratio: 3 / 2;
    margin: 0;
    overflow: hidden;
    place-items: center;
    border-radius: var(--ui-radius-lg);
    background: var(--color-surface-container-low);
  }

  .project-card figure :global(picture),
  .project-card figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-card figure :global(img) {
    object-fit: cover;
  }

  /* The GoFarmWork mark ships on pure black, so the card matches it exactly. */
  .project-card__figure--contain {
    background: #000;
  }

  .project-card__figure--contain :global(img) {
    object-fit: contain;
    padding: clamp(1.5rem, 7%, 4.5rem);
  }

  /* Photoreal project visuals: a night radar scope and a golden-hour solar array. */
  .project-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .project-media--radar {
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 50% 42%, #0e1a15 0%, #060b09 58%, #020403 100%);
  }

  .radar-scope {
    position: relative;
    width: min(72%, 23rem);
    aspect-ratio: 1;
    padding: 0.6rem;
    border-radius: 50%;
    background: linear-gradient(150deg, #333a37 0%, #1a1f1d 40%, #0b0e0d 100%);
    box-shadow:
      0 34px 60px -26px rgb(0 0 0 / 0.9),
      inset 0 1px 0 rgb(255 255 255 / 0.16),
      inset 0 -1px 0 rgb(0 0 0 / 0.6);
  }

  .radar-scope__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, #05170e 0%, #030d08 58%, #010503 100%);
    box-shadow: inset 0 0 55px rgb(0 0 0 / 0.95);
  }

  .radar-scope__rotor {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: nova-radar-sweep 4.4s linear infinite;
  }

  .radar-scope__trail {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgb(74 222 128 / 0) 0deg,
      rgb(74 222 128 / 0) 246deg,
      rgb(74 222 128 / 0.09) 296deg,
      rgb(74 222 128 / 0.26) 338deg,
      rgb(134 239 172 / 0.54) 356deg,
      rgb(186 250 214 / 0.82) 360deg
    );
  }

  .radar-scope__beam {
    position: absolute;
    top: 0;
    left: calc(50% - 1px);
    display: block;
    width: 2px;
    height: 50%;
    background: linear-gradient(to bottom, rgb(198 252 222 / 0.95), rgb(74 222 128 / 0));
    filter: drop-shadow(0 0 6px rgb(74 222 128 / 0.85));
  }

  .radar-scope__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .radar-rings circle {
    fill: none;
    stroke: rgb(74 222 128 / 0.3);
    stroke-width: 1.2;
  }

  .radar-cross line {
    stroke: rgb(74 222 128 / 0.18);
    stroke-width: 1;
  }

  .radar-ticks line {
    stroke: rgb(134 239 172 / 0.55);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .radar-scope__blip {
    position: absolute;
    display: block;
    width: 3.4%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(186 250 214);
    box-shadow:
      0 0 8px 3px rgb(74 222 128 / 0.8),
      0 0 22px 9px rgb(74 222 128 / 0.28);
    opacity: 0;
    animation: nova-radar-blip 4.4s linear infinite;
  }

