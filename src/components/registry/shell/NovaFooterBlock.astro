---
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";
import company from "@data/global/company.json";
import { getEnabledSocialLinks } from "@utils/socials";
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";

interface Props {
  locale?: NovaLocale;
}

const { locale = "pl" } = Astro.props as Props;
const id = locale === "pl" ? "kontakt" : "contact";
const copy = getNovaCopy(locale).footer;
const footerLinks = copy.footerLinks.map((link) => ({ ...link, href: getNovaNavigationPath(link.href, locale) }));

// Why: contact details come from company.json (SSOT), so the footer never
// hardcodes an address, a phone number or a profile link.
const contactLinks = [
  { href: `mailto:${company.email}`, label: company.email, icon: "envelope" },
  { href: `tel:${company.phone.replace(/[^+\d]/g, "")}`, label: company.phone, icon: "phone" },
];
const socialLinks = getEnabledSocialLinks(company);
---

<footer id={id} style="background-image: url('/assets/images/t001-nova/t001-nova-cta-mountains@1920.webp')" class="relative overflow-hidden rounded-t-[var(--rounded-lg)] bg-black bg-cover bg-center bg-no-repeat text-brand-light">
  <div class="absolute inset-0 bg-black/70" aria-hidden="true"></div>
  <div class="ui-container relative z-10 mx-auto grid w-[min(100%-2rem,80rem)] gap-10 py-16 pb-8 sm:py-20" data-scroll-depth="0.06">
    {/* Why: an explicit sequence staggers the close. The engine otherwise
        auto-reveals only the footer's first group, which left the lower rows
        static while the top animated. */}
    <div class="mx-auto max-w-5xl text-center" data-motion-sequence="viewport" data-motion-profile="soft">
      <p class="mb-4 flex items-center justify-center gap-4 text-xs font-bold uppercase tracking-[0.14em] text-white">
        <span class="h-px w-10 bg-white/70" aria-hidden="true"></span>
        <span>{copy.eyebrow}</span>
        <span class="h-px w-10 bg-white/70" aria-hidden="true"></span>
      </p>
      <Heading tag="h2" class="m-0 max-w-none !text-[clamp(2.5rem,7vw,5.5rem)] !leading-[0.95] !tracking-[-0.06em] text-brand-light lg:whitespace-nowrap">{copy.heading}</Heading>
      <Text tag="p" variant="lead" class="mx-auto mt-6 max-w-xl !text-[clamp(1rem,1.5vw,1.2rem)] !leading-[1.55] text-brand-light/80">{copy.description}</Text>
      <div class="mx-auto mt-10 flex w-full max-w-xs flex-col justify-center gap-3 sm:mt-12 sm:max-w-none sm:flex-row">
        <Button href={getNovaNavigationPath(copy.primaryHref, locale)} variant="accent" class="min-h-11 w-full sm:w-auto">{copy.primaryLabel}</Button>
        <Button href={getNovaNavigationPath(copy.secondaryHref, locale)} variant="outline" class="min-h-11 w-full !border-brand-light/65 !bg-black/50 !text-brand-light sm:w-auto">{copy.secondaryLabel}</Button>
      </div>
    </div>
    <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left" data-motion="viewport">
      <nav aria-label={copy.ariaNavigation} class="grid w-full grid-cols-2 gap-x-6 gap-y-3 sm:flex sm:w-auto sm:flex-wrap sm:justify-start lg:justify-start">
        {footerLinks.map((link) => <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-brand-light transition-colors hover:text-brand-accent sm:min-h-0">{link.label}</a>)}
      </nav>
    </div>
    <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left" data-motion="viewport">
      <nav aria-label={copy.ariaContact} class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 sm:justify-start">
        {contactLinks.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 items-center gap-2 text-sm text-brand-light/80 transition-colors hover:text-brand-accent">
            <Icon name={link.icon} class="shrink-0" />
            <span>{link.label}</span>
          </a>
        ))}
      </nav>
      <nav aria-label={copy.ariaSocial} class="flex flex-wrap items-center justify-center gap-3 sm:justify-end">
        {socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noreferrer"
            aria-label={social.label}
            class="inline-flex size-10 items-center justify-center rounded-full border border-brand-light/30 text-brand-light transition-colors hover:border-brand-accent hover:text-brand-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
          >
            <Icon name={social.icon} />
          </a>
        ))}
      </nav>
    </div>
    <div class="flex flex-col items-center gap-4 border-t border-brand-light/25 pt-8 text-center text-brand-light/75 sm:flex-row sm:items-center sm:justify-between sm:text-left" data-motion="viewport">
      <Text tag="span" variant="feature-body-sm">{copy.copyright}</Text>
      <Text tag="span" variant="feature-body-sm" class="sm:text-right">{copy.attributionPrefix}<a href={copy.attributionLinkHref} target="_blank" rel="noreferrer" class="text-brand-light transition-colors hover:text-brand-accent">{copy.attributionLinkLabel}</a></Text>
    </div>
  </div>
</footer>


